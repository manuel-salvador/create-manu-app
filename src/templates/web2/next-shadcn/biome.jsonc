{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["ultracite"],
	"files": {
		"includes": [
			"**/*",
			"!src/components/ui/*",
			"!src/app/globals.css",
			"!.next/*"
		]
	},
	"linter": {
		"rules": {
			"style": {
				"useBlockStatements": "off",
				"noMagicNumbers": "off"
			}
		}
	}
}
