{
  "extends": ["plugin:prettier/recommended", "plugin:@typescript-eslint/recommended"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": [
      "warn",
      {
        "endOfLine": "auto",
        "printWidth": 100,
        "trailingComma": "all",
        "singleQuote": true,
        "bracketSpacing": true
      }
    ],
    "no-unused-vars": "error"
  }
}
